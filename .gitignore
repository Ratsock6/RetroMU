# --- Build artefacts -------------------------------------------------------
build/
cmake-build-*/
compile_commands.json

# --- Development ROMs ------------------------------------------------------
# The subject (p.6 and p.11) forbids any commercial ROM in the repository.
# ROMs used while developing (Blargg, personally owned dumps) live here and
# must NEVER be committed. The official MIT bundle is versioned in roms/.
roms-dev/

# --- Runtime data ----------------------------------------------------------
*.sav        # battery-backed cartridge RAM (section V.5)
*.rtc        # real time clock state (MBC3 bonus)
*.state      # save states (bonus)
*.ppm        # framebuffer captures
trace*.log   # CPU trace logs

# --- Misc ------------------------------------------------------------------
.cache/
.vscode/
.idea/
*.o
*.swp
